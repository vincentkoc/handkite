{
  "version": 1,
  "cases": [
    {
      "name": "tap",
      "prepare": [
        {
          "tool": "handkite_observe",
          "arguments": {}
        },
        {
          "tool": "handkite_launch_app",
          "arguments": {
            "bundle_id": "com.apple.mobilenotes"
          },
          "expect": {
            "app": "com.apple.mobilenotes",
            "lock": "unlocked"
          },
          "when": {
            "app_not": "com.apple.mobilenotes"
          }
        },
        {
          "tool": "handkite_click_button",
          "selector": {
            "type": "Button",
            "label": "Done"
          },
          "when": {
            "keyboard": true
          },
          "expect": {
            "keyboard": false,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            }
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "app": "com.apple.mobilenotes",
            "lock": "unlocked",
            "keyboard": false,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            }
          }
        }
      ],
      "measure": {
        "tool": "handkite_tap",
        "arguments": {
          "at": {
            "x": 55,
            "y": 136
          }
        },
        "expect": {
          "keyboard": true,
          "text": {
            "type": "TextView",
            "value": "Alpha\n"
          }
        }
      },
      "cleanup": [
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "keyboard": true,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            }
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "keyboard": true,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            },
            "tree_changed": false
          }
        },
        {
          "tool": "handkite_click_button",
          "selector": {
            "type": "Button",
            "label": "Done"
          },
          "when": {
            "keyboard": true
          },
          "expect": {
            "keyboard": false,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            }
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "keyboard": false,
            "text": {
              "type": "TextView",
              "value": "Alpha\n"
            }
          }
        }
      ]
    },
