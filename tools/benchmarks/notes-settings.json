    {
      "name": "swipe",
      "prepare": [
        {
          "tool": "handkite_observe",
          "arguments": {}
        },
        {
          "tool": "handkite_launch_app",
          "arguments": {
            "bundle_id": "com.apple.Preferences"
          },
          "expect": {
            "app": "com.apple.Preferences",
            "lock": "unlocked"
          },
          "when": {
            "app_not": "com.apple.Preferences"
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "app": "com.apple.Preferences",
            "lock": "unlocked",
            "keyboard": false,
            "text": {
              "type": "StaticText",
              "label": "Airplane Mode"
            }
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "expect": {
            "app": "com.apple.Preferences",
            "lock": "unlocked",
            "text": {
              "type": "StaticText",
              "label": "Battery"
            }
          }
        }
      ],
      "measure": {
        "tool": "handkite_swipe",
        "arguments": {
          "from": {
            "x": 195,
            "y": 650
          },
          "to": {
            "x": 195,
            "y": 250
          },
          "duration_ms": 500
        },
        "expect": {
          "app": "com.apple.Preferences",
          "lock": "unlocked",
          "tree_changed": true,
          "row_moved": {
            "selector": {
              "type": "StaticText",
              "label": "Battery"
            },
            "minimum": 100
          }
        }
      },
      "cleanup": [
        {
          "tool": "handkite_observe",
          "settle": 5,
          "expect": {
            "app": "com.apple.Preferences",
            "lock": "unlocked"
          }
        },
        {
          "tool": "handkite_swipe",
          "arguments": {
            "from": {
              "x": 195,
              "y": 250
            },
            "to": {
              "x": 195,
              "y": 650
            },
            "duration_ms": 500
          }
        },
        {
          "tool": "handkite_observe",
          "arguments": {},
          "settle": 5,
          "expect": {
            "text": {
              "type": "StaticText",
              "label": "Airplane Mode"
            }
          }
        }
      ]
    },
