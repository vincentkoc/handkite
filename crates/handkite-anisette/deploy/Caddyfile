# anisette.example.invalid is a reserved placeholder that can never obtain a
# certificate. Replace it with the admitted sidecar hostname before installing;
# the Mac client must be given the same origin with --origin.
anisette.example.invalid {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/handkite/anisette-client-ca.pem
		}
	}

	log {
		output discard
	}

	# Upstream accepts a backend query override even with a configured default.
	# URI equality also rejects Caddy's normalized/case-insensitive path aliases.
	@v3_get {
		method GET
		path /v3/client_info /v3/provisioning_session
		query ""
		vars {http.request.uri} /v3/client_info /v3/provisioning_session
	}
	@v3_post {
		method POST
		path /v3/get_headers
		query ""
		vars {http.request.uri} /v3/get_headers
	}
	handle @v3_get {
		reverse_proxy 127.0.0.1:6969
	}
	handle @v3_post {
		reverse_proxy 127.0.0.1:6969
	}
	handle {
		respond 404
	}
}
